PORT=5000
NODE_ENV=development
CRAWL_TIMEOUT=10
MAX_DEPTH=2
HF_TOKEN=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_QUOTA=100
GOOGLE_CSE_MAX_KEYWORDS_PER_PAGE=3
GOOGLE_CSE_CACHE_TTL_HOURS=24

# Central database. Unset = SQLite at $SESSION_DIR/central/platform.db.
# Postgres: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
# Bearer token for POST /api/cron/run. Unset = route disabled.
CRON_SECRET=
# Run due scheduled audits in-process every 15 minutes.
SCHEDULER_ENABLED=false

# --- Rank tracking (SERP providers) -----------------------------------------
# dataforseo | google_cse | dry_run. Unset: google_cse if its key is set, else dry_run.
SERP_PROVIDER=
# Paid providers stay in dry run until this is exactly "false".
# Set to false only when you mean to spend money.
SERP_DRY_RUN=true
# Hard daily cap on paid SERP calls (DataForSEO). Google CSE uses GOOGLE_CSE_DAILY_QUOTA.
SERP_DAILY_CAP=50
# Results requested per tracked keyword (max 200).
RANK_DEPTH=100
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Hard daily cap on DataForSEO keyword-data calls (volume, difficulty, ranked
# keywords). Cached answers are free and don't count.
DATAFORSEO_LABS_DAILY_CAP=20
# Hard daily cap on DataForSEO Backlinks API requests (~$0.024 each plus
# $0.000036 a row; one backlink snapshot is 5 requests, about $0.25).
DATAFORSEO_BACKLINKS_DAILY_CAP=20
# Core Web Vitals. PageSpeed Insights key (free, quota'd); empty = not used.
PSI_API_KEY=
# Hard daily cap on PSI calls, and pages measured per audit.
PSI_DAILY_CAP=50
PSI_MAX_PAGES=5
# Local Lighthouse fallback: needs Node, Chrome and `npm i -g lighthouse@12`.
LIGHTHOUSE_ENABLED=false
# Optional: Chrome binary and Lighthouse CLI script (auto-detected when empty).
CHROME_PATH=
LIGHTHOUSE_CLI=
# JavaScript rendering (when an audit asks for it): pages rendered and the
# per-page timeout. Needs Playwright's Chromium: `python -m playwright install chromium`.
RENDER_MAX_PAGES=20
RENDER_TIMEOUT_MS=20000
# Google Search Console (read-only). Path to a service account's JSON key; add
# the service account's email as a user on each property. Empty = not used.
GSC_SERVICE_ACCOUNT_FILE=
# true = made-up Search Console data, to try the UI without Google.
GSC_DRY_RUN=false
# Hard daily caps (analytics calls, URL inspections) and pages inspected per audit.
GSC_DAILY_CAP=100
GSC_INSPECT_DAILY_CAP=200
GSC_INSPECT_MAX_PAGES=20

# AI Visibility: prompts asked of AI models with their own web search
# (about $0.02-0.05 per prompt per model). Each provider needs its key; OpenAI
# and Gemini also need the model you want. No keys = made-up dry-run answers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Web-search tool names, in case a provider versions them.
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305
OPENAI_WEB_SEARCH_TOOL=web_search
AI_VISIBILITY_DRY_RUN=false
# Hard daily cap on AI calls (each prompt x model is one call).
AI_VISIBILITY_DAILY_CAP=30

# --- Rank alerts --------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Comma-separated
ALERT_EMAIL_TO=
