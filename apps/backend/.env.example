PORT=5000
NODE_ENV=development
CRAWL_TIMEOUT=10
MAX_DEPTH=2
HF_TOKEN=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_QUOTA=100
GOOGLE_CSE_MAX_KEYWORDS_PER_PAGE=3
GOOGLE_CSE_CACHE_TTL_HOURS=24

# Central database. Unset = SQLite at $SESSION_DIR/central/platform.db.
# Postgres: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
# Bearer token for POST /api/cron/run. Unset = route disabled.
CRON_SECRET=
# Run due scheduled audits in-process every 15 minutes.
SCHEDULER_ENABLED=false
