PORT=5000
NODE_ENV=development
CRAWL_TIMEOUT=10
MAX_DEPTH=2
HF_TOKEN=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_QUOTA=100
GOOGLE_CSE_MAX_KEYWORDS_PER_PAGE=3
GOOGLE_CSE_CACHE_TTL_HOURS=24

# Central database. Unset = SQLite at $SESSION_DIR/central/platform.db.
# Postgres: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
# Bearer token for POST /api/cron/run. Unset = route disabled.
CRON_SECRET=
# Run due scheduled audits in-process every 15 minutes.
SCHEDULER_ENABLED=false

# --- Rank tracking (SERP providers) -----------------------------------------
# dataforseo | google_cse | dry_run. Unset: google_cse if its key is set, else dry_run.
SERP_PROVIDER=
# Paid providers stay in dry run until this is exactly "false".
# Set to false only when you mean to spend money.
SERP_DRY_RUN=true
# Hard daily cap on paid SERP calls (DataForSEO). Google CSE uses GOOGLE_CSE_DAILY_QUOTA.
SERP_DAILY_CAP=50
# Results requested per tracked keyword (max 200).
RANK_DEPTH=100
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Hard daily cap on DataForSEO keyword-data calls (volume, difficulty, ranked
# keywords). Cached answers are free and don't count.
DATAFORSEO_LABS_DAILY_CAP=20

# --- Rank alerts --------------------------------------------------------------
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# Comma-separated
ALERT_EMAIL_TO=
