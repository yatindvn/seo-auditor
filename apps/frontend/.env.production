# Build-time configuration for production. Next.js inlines NEXT_PUBLIC_* into the
# client bundle, so these are public values, not secrets -- every visitor
# downloads them.
#
# Real environment variables take precedence over this file, so setting these in
# the Vercel dashboard still overrides what is here.
#
# Backend runs on Oracle Cloud; see docs/deployment-oracle.md. Update both lines
# if the VM's public IP changes.
NEXT_PUBLIC_API_URL=https://129.153.42.187.nip.io
NEXT_PUBLIC_WS_URL=wss://129.153.42.187.nip.io/ws
