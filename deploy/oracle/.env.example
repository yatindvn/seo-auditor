# Copy to deploy/oracle/.env on the VM and fill in. Never commit the real file.

# Public DNS name for the backend. Let's Encrypt cannot issue for a bare IP.
# No domain? nip.io maps <ip>.nip.io to that IP and passes HTTP-01 validation:
#   BACKEND_DOMAIN=203.0.113.10.nip.io
BACKEND_DOMAIN=

# The frontend's exact origin, comma-separated for more than one. Required once
# the frontend is on a different domain, or the browser blocks every API call.
#   ALLOWED_ORIGINS=https://seo-auditor.vercel.app
ALLOWED_ORIGINS=

# Google Custom Search. Leave blank to run without rank checking -- every rank
# result then reports status "skipped", which the UI shows honestly.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_DAILY_QUOTA=100
GOOGLE_CSE_MAX_KEYWORDS_PER_PAGE=3
GOOGLE_CSE_CACHE_TTL_HOURS=24

CRAWL_TIMEOUT=10
