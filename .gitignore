# ─── Node / Next.js (frontend) ───────────────────────────────
node_modules/
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Package manager logs & caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── Python (backend) ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── SEO Auditor generated reports ───────────────────────────
audit_output/
audit_outpu/
seo_audit_output/
*.audit_report.json

# ─── Environment & secrets ───────────────────────────────────
.env
.env.*
!.env.example
# NEXT_PUBLIC_* values are compiled into the client bundle and served to every
# visitor, so the backend URL is public by construction -- committing it leaks
# nothing that opening the site would not reveal. Tracked here because Vercel
# dashboard variables were not reaching this project's production builds, and a
# file in the repo is verifiable from the outside.
!apps/frontend/.env.production
*.pem
*.key

# ─── Editor / OS ─────────────────────────────────────────────
.agents/
.claude/worktrees/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
*.swp
*~

# Per-session SQLite audit files (app/models/session_db.py). Runtime data:
# regenerated by every audit, never source.
apps/backend/sessions/
